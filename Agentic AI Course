    {
      "cell_type": "code",
      "source": [
        "class SentimentResult(BaseModel):\n",
        "    sentiment: Literal[\"positive\", \"neutral\", \"negative\"] = Field(\n",
        "        description=\"The sentiment of the input text\"\n",
        "    )"
      ],
      "metadata": {
        "id": "H1vde_uc-9_H"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "model_sentiment = ChatOpenAI(\n",
        "    model=\"openrouter/owl-alpha\",\n",
        "    temperature=0,\n",
        "    base_url=\"https://openrouter.ai/api/v1\",\n",
        "    api_key=os.environ.get(\"OPENROUTER_API_KEY2\"),\n",
        ").with_structured_output(SentimentResult)"
      ],
      "metadata": {
        "id": "K6yNsEHWDKbX"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "sentences = [\n",
        "    \"Kindness creates lasting joy.\",\n",
        "    \"Success rewards persistent effort.\",\n",
        "    \"I love Sunlight. It warms the skin.\",\n",
        "    \"Pessemestic all the time.\",\n",
        "    \"The storm caused damage!\",\n",
        "    \"The clock ticks steadily.\"\n",
        "]\n",
        "\n",
        "results = []\n",
        "for s in sentences:\n",
        "  result = model_sentiment.invoke(s)\n",
        "  results.append({\"sentence\": s, \"sentiment\": result.sentiment})\n",
        "\n",
        "for item in results:\n",
        "    print(f\"{item['sentence']} -> {item['sentiment']}\")"
      ],
